NUXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
NUXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
NUXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

NUXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
# Secret PayPal (app REST, onglet « Secret ») — serveur uniquement
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# sandbox ou live
PAYPAL_MODE=sandbox

NUXT_PUBLIC_ADMIN_NOTIFY_EMAIL=admin@example.com
NUXT_PUBLIC_ADMIN_NOTIFY_PHONE=0612345678

ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=0612345678

RESEND_API_KEY=your-resend-api-key
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_PHONE=+33123456789

GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@example.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=primary
