NUXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
NUXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
NUXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

NUXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
# Secret REST (Dashboard PayPal → Apps → ton app sandbox → Secret) — obligatoire pour create-order / capture
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# variante Nuxt : NUXT_PAYPAL_CLIENT_SECRET=...
# sandbox ou live
PAYPAL_MODE=sandbox

NUXT_PUBLIC_ADMIN_NOTIFY_EMAIL=admin@example.com
NUXT_PUBLIC_ADMIN_NOTIFY_PHONE=0612345678

ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=0612345678

RESEND_API_KEY=your-resend-api-key
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_PHONE=+33123456789

# Firebase Admin + Calendar — compte de service du projet Firebase (studio-booking-…)
# Netlify : utiliser GOOGLE_SERVICE_ACCOUNT_JSON (JSON minifié sur une ligne) — voir docs/netlify-deploy.md
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Local : chemin vers le JSON téléchargé (recommandé sous Windows)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
# Alternative : email + clé (doivent correspondre ; sinon « Invalid JWT Signature »)
GOOGLE_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk-xxxxx@studio-booking-804ff.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=primary
